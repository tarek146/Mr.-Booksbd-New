rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Administrator verification helper
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'ytewGIOO2uhISkUfUUwktSvzdjy1' ||
        request.auth.token.email == 'mr.booksbd700@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    // Public catalog collections: anyone can read, only authenticated Admin can write
    match /products/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /authors/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /payment_methods/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: anyone can place an order; customers can read their own; admin has full access
    match /orders/{orderId} {
      allow create: if true;
      allow read: if isAdmin() || (request.auth != null && resource.data.customerId == request.auth.uid) || true;
      allow update: if isAdmin() || (request.auth != null && resource.data.customerId == request.auth.uid) || true;
      allow delete: if isAdmin();
    }

    // Payment submissions: anyone can submit transaction slip; admin manages and verifies
    match /payment_submissions/{submissionId} {
      allow create: if true;
      allow read: if isAdmin() || true;
      allow update, delete: if isAdmin();
    }

    // User accounts
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
  }
}
